{
  "manifest_version": 3,
  "name": "TV Unlimit 0x — TradingView Drawing Unlock",
  "version": "1.1.0",
  "description": "Disables TradingView's client-side drawing limit (per-chart and aggregate). Seamless; drawings still save to the server.",
  "minimum_chrome_version": "100",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*"
      ],
      "js": [
        "src/intercept.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}